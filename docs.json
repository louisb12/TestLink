{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Almedia Launchpad",
  "description": "Documentation for Almedia Link — the rewarded link that turns players into earners. Integration guides for publishers, product teams and engineers.",
  "theme": "aspen",
  "colors": {
    "primary": "#0021F3",
    "light": "#739AC1",
    "dark": "#0021F3"
  },
  "fonts": {
    "heading": {
      "family": "Daimito Expanded",
      "weight": 600,
      "source": "/fonts/DaimitoExpanded-Semibold.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0D2440"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "night-owl"
      }
    }
  },
  "logo": {
    "light": "/logos/symbol-lead-blue.svg",
    "dark": "/logos/symbol-white.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/almedia-tm/almedia-sdk",
        "icon": "github"
      }
    ]
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/almedia-tm/almedia-sdk",
      "linkedin": "https://www.linkedin.com/company/almedia"
    },
    "links": [
      {
        "header": "Overview",
        "items": [
          {
            "label": "What is Almedia Link",
            "href": "/overview/what-is-almedia-link"
          },
          {
            "label": "Best practices",
            "href": "/overview/best-practices"
          },
          {
            "label": "How revenue works",
            "href": "/overview/how-revenue-works"
          },
          {
            "label": "Get started",
            "href": "/overview/get-started"
          }
        ]
      },
      {
        "header": "Product & UA",
        "items": [
          {
            "label": "Prerequisites",
            "href": "/publisher/prerequisites"
          },
          {
            "label": "Experiences",
            "href": "/publisher/experiences"
          },
          {
            "label": "MMP Setup",
            "href": "/publisher/mmp"
          },
          {
            "label": "QA",
            "href": "/qa"
          }
        ]
      },
      {
        "header": "For Engineering",
        "items": [
          {
            "label": "Overview",
            "href": "/technical"
          },
          {
            "label": "Integration guide",
            "href": "/technical/integration-guide"
          },
          {
            "label": "API reference",
            "href": "/technical/api-reference"
          },
          {
            "label": "SDK on GitHub",
            "href": "https://github.com/almedia-tm/almedia-sdk"
          }
        ]
      },
      {
        "header": "For agents",
        "items": [
          {
            "label": "llms.txt",
            "href": "/llms.txt"
          },
          {
            "label": "llms-full.txt",
            "href": "/llms-full.txt"
          },
          {
            "label": "MCP server",
            "href": "/mcp"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Almedia Launchpad",
      "og:type": "website",
      "twitter:card": "summary_large_image"
    },
    "organization": {
      "name": "Almedia",
      "url": "https://almedia.co"
    }
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "DM Sans"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "That page moved, or never existed",
      "description": "Pick a path instead — the [Overview](/overview) for what Almedia Link is, [For Product & UA](/publisher) for placement, planning and attribution, [For QA](/qa) for sign-off, or [For Engineering](/technical) for the SDK. Or start from the [top](/)."
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/overview/get-started",
      "permanent": true
    },
    {
      "source": "/introduction",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/best-practices",
      "destination": "/overview/best-practices",
      "permanent": true
    },
    {
      "source": "/almedia-link-showcase",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/best-practices-2",
      "destination": "/overview/best-practices",
      "permanent": true
    },
    {
      "source": "/webgl-test",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/publisher/best-practices",
      "destination": "/overview/best-practices",
      "permanent": true
    },
    {
      "source": "/overview/experiences",
      "destination": "/publisher/experiences",
      "permanent": true
    }
  ]
}
