{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Almedia Link",
  "colors": {
    "primary": "#0021F3",
    "light": "#739AC1",
    "dark": "#0D2A4C"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
